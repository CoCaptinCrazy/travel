# Copy this file to .env to configure your local TravelX instance.
TRAVELX_HOST=127.0.0.1
TRAVELX_PORT=3000
TRAVELX_COOKIE_SECURE=0
# Set when serving behind an HTTPS reverse proxy.
# TRAVELX_ORIGIN=https://travelx.example
# Optional custom SQLite database path.
# TRAVELX_DB=databases/travelx.db

# Nova: get a Gemini key from Google AI Studio.
GEMINI_API_KEY=your-gemini-api-key
# Copilot SDK fallback uses local Copilot CLI sign-in or a GitHub token.
# There is no separate Copilot API key. Replace only if using token authentication.
COPILOT_GITHUB_TOKEN=your-copilot-github-token
COPILOT_USE_CLI_AUTH=1

# Cinema: TMDB API key for movie metadata and search (not video streams).
TMDB_API_KEY=your-tmdb-api-key

# Music provider credentials; the official embeds do not require these values.
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
YOUTUBE_MUSIC_API_KEY=your-youtube-data-api-key
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
